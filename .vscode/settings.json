{
  "typescript.tsconfig": "tsconfig.json",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "eslint.useFlatConfig": true,
  "eslint.workingDirectories": [{ "mode": "auto" }],
  "eslint.problems.shortenToSingleLine": true,
  "files.exclude": {
    "**/.git": true,
    "**/node_modules": true,
    "**/dist": true,
    "**/dist-ssr": true,
    "**/playwright-report": true,
    "**/test-results": true,
    "**/blob-report": true,
    "**/.output": true,
    "**/.vinxi": true,
    "**/.tanstack": true,
    "**/coverage": true,
    "**/supabase/.temp": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/dist-ssr": true,
    "**/playwright-report": true,
    "**/test-results": true,
    "**/blob-report": true,
    "**/bun.lock": true
  },
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/playwright-report/**": true,
    "**/test-results/**": true,
    "**/.tanstack/**": true,
    "**/coverage/**": true,
    "**/supabase/.temp/**": true
  },
  "cSpell.enabled": false,

  // VPN 사용 시 터미널 git/bun/npm이 OS 프록시 상속 (Cursor User settings와 함께)
  "terminal.integrated.inheritEnv": true,
  "terminal.integrated.env.windows": {
    "NO_PROXY": "localhost,127.0.0.1,::1,192.168.0.0/16,10.0.0.0/8"
  }
}
