{
  "name": "@phonara/web",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "dev:kill": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/kill-dev-port.ps1",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:strict": "eslint . --max-warnings=0",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:public": "playwright test --project=public",
    "test:e2e:report": "playwright show-report",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:verify-creds": "bun scripts/verify-e2e-creds.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "bun run typecheck && bun run test && bun run build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/admin/tsconfig.json",
    "format": "prettier --write .",
    "admin:dev": "pnpm --filter @phonara/admin dev",
    "admin:build": "pnpm --filter @phonara/admin build",
    "supabase:config:push": "bun scripts/push-supabase-auth-config.ts"
  },
  "packageManager": "pnpm@9.15.4",
