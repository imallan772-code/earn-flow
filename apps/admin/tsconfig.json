{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["../../src/*"]
    }
  },
  "include": [
    "src",
    "../../src/features/admin",
    "../../src/features/auth",
    "../../src/shared",
    "../../src/lib",
    "../../src/integrations",
    "../../src/components",
    "../../src/hooks",
    "../../src/mocks"
  ]
}
