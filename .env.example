# Supabase — https://kanftnqenuzverroodev.supabase.co
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Local dev site origin (email/OAuth redirectTo fallback on SSR)
VITE_SITE_URL=http://localhost:8080

# Push supabase/config.toml auth settings to phonara-gb (one-time / after edits)
# Token: https://supabase.com/dashboard/account/tokens
# SUPABASE_ACCESS_TOKEN=sbp_xxx
# Part 5 security (HIBP + 7 notifications): bun run supabase:auth:part5
# Branded emails (Free + Custom SMTP): docs/SMTP_PHONARA_SETUP.md → bun run supabase:auth:smtp

# Custom SMTP — Resend example (Free Supabase plan OK)
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASS=re_xxx
# SMTP_ADMIN_EMAIL=onboarding@resend.dev
# SMTP_SENDER_NAME=PHONARA

# Google OAuth — docs/GOOGLE_OAUTH_SETUP.md → bun run supabase:auth:google
# GOOGLE_CLIENT_ID=637395881778-aqugf3bsd2da57ckbhkhctohn5c7tmfc.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=****frf7

# Admin surface (web app /admin routes — keep false in public prod until ready)
VITE_ADMIN_ENABLED=false
# Local dev: allow /admin without admin_users row (never true in production builds)
VITE_ADMIN_DEV_OPEN=true

# Money RPC v2 (idempotent debit/credit + refund). Default ON; set false to force legacy v1 debit/credit.
# VITE_MONEY_RPC_V2=false

# Live feed Realtime merge (additive over bot FOMO). Default ON; set false to disable subscription.
# VITE_LIVE_FEED_REALTIME=false
# E2E_BASE_URL=http://localhost:8080
# E2E_USER_EMAIL=imallan772@gmail.com
# REQUIRED: wrap passwords containing $ or % in double quotes (Bun mangles bare $ in process.env)
# E2E_USER_PASSWORD="your-password-with-special-chars"
# Verify: bun run test:e2e:verify-creds  (never use process.env.E2E_USER_PASSWORD in scripts)

# Server-only (Cloudflare .dev.vars or deployment secrets) — NEVER VITE_* (exposes to browser)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_ACCESS_TOKEN=sbp_xxx  # bun run supabase:db:push
# CRASH_CRON_SECRET=generate-a-long-random-string-for-crash-cron
# PROMO_CRON_SECRET=generate-a-long-random-string-for-cron-hmac
# PROMO_OAUTH_STATE_SECRET=optional-separate-secret-for-oauth-cookie-hmac

# Promo OAuth — server-only (register redirect URI → /api/admin/promo/oauth/{x|linkedin|tiktok}/callback)
# X: https://developer.twitter.com/
# X_CLIENT_ID=
# X_CLIENT_SECRET=
# LinkedIn: https://www.linkedin.com/developers/
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# TikTok: https://developers.tiktok.com/
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=

# Promo AI — server-only (never VITE_*). Flash free tier: https://aistudio.google.com/apikey
# 우선순위: OPENROUTER → GEMINI → LOVABLE
# OpenRouter (KR에서 Gemini 직통 geo block 시 권장): https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_PROMO_MODEL=openrouter/free
# 1st priority direct Gemini (지역 제한 있음):
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# 2nd priority (Lovable preview only, when GEMINI_API_KEY unset):
# LOVABLE_API_KEY=
# LOVABLE_PROMO_MODEL=google/gemini-3-flash-preview
