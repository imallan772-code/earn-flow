# Supabase — https://kanftnqenuzverroodev.supabase.co
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Local dev site origin (email/OAuth redirectTo fallback on SSR)
VITE_SITE_URL=http://localhost:8080

# Push supabase/config.toml auth settings to phonara-gb (one-time / after edits)
# Token: https://supabase.com/dashboard/account/tokens
# SUPABASE_ACCESS_TOKEN=sbp_xxx

# Google OAuth — enable in supabase/config.toml [auth.external.google] then push config
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Admin surface (web app /admin routes — keep false in public prod until ready)
VITE_ADMIN_ENABLED=false
# Local dev: allow /admin without admin_users row (never true in production builds)
VITE_ADMIN_DEV_OPEN=true

# Server-only (Cloudflare .dev.vars or deployment secrets)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
